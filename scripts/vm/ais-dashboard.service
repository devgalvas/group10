[Unit]
Description=AIS port congestion dashboard (Streamlit)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/ais-pipeline/current
ExecStart=/home/ubuntu/ais-env-prod/bin/streamlit run dashboard/app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true -- --env prod
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
